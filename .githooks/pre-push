#!/usr/bin/env python3
"""推送当前 main 或更新远端 main 前运行 Rust 格式检查。"""

import os
import subprocess
import sys

root = subprocess.run(
    ["git", "rev-parse", "--show-toplevel"],
    check=True,
    capture_output=True,
    text=True,
).stdout.strip()
branch = subprocess.run(
    ["git", "symbolic-ref", "--quiet", "--short", "HEAD"],
    cwd=root,
    check=False,
    capture_output=True,
    text=True,
).stdout.strip()
should_check = branch == "main"
for line in sys.stdin:
    fields = line.split()
    if len(fields) == 4 and (
        fields[0] == "refs/heads/main" or fields[2] == "refs/heads/main"
    ):
        should_check = True

if should_check:
    result = subprocess.run(
        [sys.executable, os.path.join(root, "tools", "git-hooks", "check_format.py")],
        cwd=root,
        check=False,
    )
    raise SystemExit(result.returncode)
