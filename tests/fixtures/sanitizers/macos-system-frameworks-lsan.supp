# macOS 26 上 Qt 翻译初始化会留下进程级 CoreFoundation 偏好设置缓存。
leak:CFPrefsPlistSource
leak:synchronouslySendSystemMessage:andUserMessage:andDirectMessage

# macOS 字体后端首次使用 NSFont 时会注册进程级 CoreFoundation 通知观察者。
leak:+[NSFont initialize]

# Qt 字体发现和绘制会初始化进程级 CoreText/CoreGraphics 字体缓存。
leak:TGlobalFontRegistry
leak:QCoreTextFontDatabase::populateFontDatabase
leak:QCoreTextFontEngine::init

# Apple 色彩转换会在进程生命周期内保留 CoreGraphics ColorSync 转换缓存。
leak:CGCMSConverterCreate

# CoreText 回退字体发现会在进程生命周期内保留字体描述符和可变字体缓存根对象。
leak:TDescriptorSource::CopyDescriptorUncached
leak:TCGFontCache::CopyFontWithOpticalSizeVariation

# macOS 26 的字体注册表会在 XPC 回调中保留已解码的 URL 对象。
leak:XTCopyPropertiesForFontsMatchingRequest
leak:XTCopyPropertiesForFont

# Qt 6.12.0 / macOS 27 的完整 ASan/UBSan CTest 仍命中以下 CoreText 路径；
# 未抑制报告保留在 task 067 中，作为剩余生命周期调查项。
leak:QCoreTextFontDatabase::invalidate
leak:QCoreTextFontDatabase::fallbacksForFamily
leak:QCoreTextFontEngine::boundingBox
leak:QCoreTextFontEngine::QCoreTextFontEngine
leak:QCoreTextFontEngine::loadAdvancesForGlyphs
leak:QCoreTextFontEngine::ct_getSfntTable

# macOS 系统菜单字体初始化期间，CoreText 保留进程生命周期内的字体缓存。
leak:_refreshMenuFontsIfNeeded

# macOS 26 Nightly 的两笔泄漏报告来自 LaunchServices 通知注册回调。
leak:LaunchServices::notifyd::NotifyToken::RegisterDispatch
